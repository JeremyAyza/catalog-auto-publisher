{
	"name": "catalog-auto-publisher",
	"version": "1.0.0",
	"private": true,
	"description": "Generates product listings from photos with GPT-4o Vision and publishes them to Facebook Marketplace and Instagram.",
	"author": "Jeremy Ayza",
	"license": "MIT",
	"scripts": {
		"generate": "npx ts-node generate_dataset.ts",
		"login": "npx ts-node login.ts",
		"bot": "npx ts-node bot_marketplace.ts",
		"bot:ig": "npx ts-node bot_instagram.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"fs-extra": "^11.3.3",
		"openai": "^6.15.0",
		"playwright": "^1.57.0",
		"playwright-extra": "^4.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^25.0.9",
		"@types/sharp": "^0.31.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	},
	"volta": {
		"node": "20.20.2"
	}
}
